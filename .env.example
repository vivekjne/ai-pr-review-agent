# =============================================================================
# AI PR Review Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables are read at startup by pydantic-settings (see app/config/settings.py)

# ---------------------------------------------------------------------------
# GitHub Authentication
# ---------------------------------------------------------------------------
# Personal Access Token (classic) with repo scope for private repos.
# Create one: https://github.com/settings/tokens
# In GitHub Actions, use: ${{ secrets.GITHUB_TOKEN }} (auto-provided)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# LLM Provider (OpenCode Go / OpenAI-compatible API)
# ---------------------------------------------------------------------------
# Your API key from https://opencode.ai
OPENCODE_API_KEY=

# Base URL for the chat completions endpoint.
# Default: https://opencode.ai/zen/go/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Model identifier to use for code review.
# Options: deepseek-v4-flash, deepseek-v4-pro, or any OpenAI-compatible model
OPENCODE_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Review Behaviour
# ---------------------------------------------------------------------------
# Maximum number of files to include in a single review.
# Prevents overwhelming the LLM on large PRs.
MAX_FILES_TO_REVIEW=20

# Maximum characters of patch/diff text to send per review.
# Larger = more context but slower & more expensive.
MAX_PATCH_CHARS=12000
